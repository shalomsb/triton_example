name: "yolo11x_ensemble"
platform: "ensemble"
max_batch_size: 8

input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    name: "DETECTIONS"
    data_type: TYPE_FP32
    dims: [ -1, 6 ]
  },
  {
    name: "NUM_DETECTIONS"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

ensemble_scheduling {
  step [
    {
      model_name: "yolo11x_preprocess"
      model_version: -1
      input_map {
        key: "RAW_IMAGE"
        value: "RAW_IMAGE"
      }
      output_map {
        key: "PREPROCESSED_IMAGE"
        value: "preprocessed_image"
      }
      output_map {
        key: "SCALE_INFO"
        value: "scale_info"
      }
    },
    {
      model_name: "yolo11x"
      model_version: -1
      input_map {
        key: "images"
        value: "preprocessed_image"
      }
      output_map {
        key: "output0"
        value: "raw_output"
      }
    },
    {
      model_name: "yolo11x_postprocess"
      model_version: -1
      input_map {
        key: "RAW_OUTPUT"
        value: "raw_output"
      }
      input_map {
        key: "SCALE_INFO"
        value: "scale_info"
      }
      output_map {
        key: "DETECTIONS"
        value: "DETECTIONS"
      }
      output_map {
        key: "NUM_DETECTIONS"
        value: "NUM_DETECTIONS"
      }
    }
  ]
}
