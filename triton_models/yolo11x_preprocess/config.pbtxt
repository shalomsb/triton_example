name: "yolo11x_preprocess"
backend: "python"
max_batch_size: 8

input [
  {
    name: "RAW_IMAGE"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    name: "PREPROCESSED_IMAGE"
    data_type: TYPE_FP32
    dims: [ 3, 640, 640 ]
  },
  {
    name: "SCALE_INFO"
    data_type: TYPE_FP32
    dims: [ 4 ]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

